POSTGRES_USER=clauseguard
POSTGRES_PASSWORD=clauseguard
POSTGRES_DB=clauseguard
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-16-characters
VOYAGE_API_KEY=replace-with-a-real-voyage-ai-api-key
GROQ_API_KEY=replace-with-a-real-groq-api-key
# M36: per-user daily contract-upload cap. Optional -- defaults to 10 if unset.
DAILY_UPLOAD_LIMIT_PER_USER=10
# M39: signup email verification via Brevo's transactional email API
# (https://www.brevo.com, free tier: 300 emails/day). Generate a real
# key at Settings -> SMTP & API -> API Keys.
BREVO_API_KEY=replace-with-a-real-brevo-api-key
# Must be a sender VERIFIED on your Brevo account (Settings -> Senders
# & IP) -- Brevo rejects sends from any other address.
BREVO_SENDER_EMAIL=replace-with-your-verified-brevo-sender-email
